{
  "name": "mcp-files-exec",
  "description": "MCP 后端：AI 直接读写任意路径、下载文件与执行命令（可选恢复沙箱限制）",
  "type": "python",
  "entry": "mcp_files_exec.py",
  "deps": "requirements.txt",
  "port": 3910,
  "version": "1.0.6",
  "config": {
    "sandbox_roots": {
      "label": "沙箱工作路径（分号分隔多个）",
      "type": "text",
      "default": "{REPO_ROOT}/data/mcp-files-exec",
      "env": "MCP_SANDBOX_ROOTS",
      "create_dir": true
    },
    "log_file": {
      "label": "审计日志路径",
      "type": "text",
      "default": "{REPO_ROOT}/logs/mcp-files-exec.log",
      "env": "MCP_LOG_FILE"
    },
    "max_export_bytes": {
      "label": "单文件导出上限（字节）",
      "type": "number",
      "default": 1048576,
      "env": "MCP_MAX_EXPORT_BYTES"
    },
    "export_ttl_seconds": {
      "label": "导出下载令牌有效期（秒）",
      "type": "number",
      "default": 300,
      "env": "MCP_EXPORT_TTL_SECONDS"
    },
    "public_url": {
      "label": "文件下载公网地址前缀（反向代理时填写）",
      "type": "text",
      "default": "",
      "env": "MCP_PUBLIC_URL"
    },
    "allow_external_paths": {
      "label": "允许访问沙箱外绝对路径（默认开启；关闭后恢复沙箱限制）",
      "type": "boolean",
      "default": true,
      "env": "MCP_ALLOW_EXTERNAL_PATHS"
    },
    "allow_dangerous_commands": {
      "label": "允许危险命令（默认开启；关闭后恢复危险命令拦截与白名单）",
      "type": "boolean",
      "default": true,
      "env": "MCP_ALLOW_DANGEROUS_COMMANDS"
    },
    "max_download_bytes": {
      "label": "下载文件上限（字节，0=不限制）",
      "type": "number",
      "default": 0,
      "env": "MCP_MAX_DOWNLOAD_BYTES"
    },
    "download_timeout": {
      "label": "下载超时（秒）",
      "type": "number",
      "default": 120,
      "env": "MCP_DOWNLOAD_TIMEOUT"
    }
  }
}
