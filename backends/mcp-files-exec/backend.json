{
  "name": "mcp-files-exec",
  "description": "MCP 后端：AI 读写文件与执行受限命令（路径沙箱 + 命令拦截 + 审计）",
  "type": "python",
  "entry": "mcp_files_exec.py",
  "deps": "requirements.txt",
  "port": 3910,
  "version": "1.0.1",
  "config": {
    "sandbox_roots": {
      "label": "沙箱工作路径（分号分隔多个）",
      "type": "text",
      "default": "{REPO_ROOT}/data/mcp-files-exec",
      "env": "MCP_SANDBOX_ROOTS",
      "create_dir": true
    },
    "log_file": {
      "label": "审计日志路径",
      "type": "text",
      "default": "{REPO_ROOT}/logs/mcp-files-exec.log",
      "env": "MCP_LOG_FILE"
    }
  }
}
