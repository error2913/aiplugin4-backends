{
  "name": "mcp-browser",
  "description": "MCP：AI 浏览器操作与截图（导航/点击/输入/快照/截图/等待；惰性启动，工具列表不拉起浏览器，首次浏览器操作才启动 Chromium，按 AI 会话隔离；browser_close 或空闲 10 分钟自动回收并关闭浏览器进程）",
  "type": "node",
  "entry": "browser.js",
  "deps": "package.json",
  "port": 8921,
  "version": "1.0.4",
  "config": {
    "browser_name": {
      "label": "浏览器类型（chromium/firefox/webkit）",
      "type": "text",
      "default": "chromium",
      "env": "AIPLUGIN4_BROWSER_NAME"
    },
    "browser_headless": {
      "label": "无头模式（开启后不显示窗口）",
      "type": "boolean",
      "default": "",
      "env": "AIPLUGIN4_BROWSER_HEADLESS"
    },
    "browser_viewport": {
      "label": "浏览器视口（宽x高，如 1280x720）",
      "type": "text",
      "default": "1280x720",
      "env": "AIPLUGIN4_BROWSER_VIEWPORT"
    },
    "browser_chromium_sandbox": {
      "label": "Chromium 沙箱（留空=自动：root/容器自动关闭；true/false 强制开关）",
      "type": "boolean",
      "default": "",
      "env": "AIPLUGIN4_BROWSER_CHROMIUM_SANDBOX"
    },
    "session_idle_minutes": {
      "label": "MCP 会话空闲回收分钟（0=不回收；空闲超时后端真正关闭浏览器 context/进程，防 CPU 常驻）",
      "type": "number",
      "default": 10,
      "env": "AIPLUGIN4_BROWSER_IDLE_MINUTES"
    }
  }
}
