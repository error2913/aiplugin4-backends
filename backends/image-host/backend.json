{
  "name": "image-host",
  "description": "私人图床 + 图库：按 URL 抓取落库（sha256 哈希去重）、只读分发与 base64 出口、来源/标签/重命名、WebUI 画廊（鉴权）、MCP 工具（搜索/重命名/打标签）",
  "type": "python",
  "entry": "imagehost.py",
  "deps": "requirements.txt",
  "port": 46680,
  "version": "1.0.13",
  "webui": {
    "path": "/",
    "title": "图床 WebUI"
  },
  "config": {
    "data_dir": {
      "label": "数据目录（SQLite + 原图分片 + 缩略图）",
      "type": "text",
      "default": "{REPO_ROOT}/data/image-host",
      "env": "AIPLUGIN4_IMAGE_HOST_DIR",
      "create_dir": true
    },
    "webui_enabled": {
      "label": "WebUI 开关（重启后端生效）",
      "type": "boolean",
      "default": true,
      "env": "AIPLUGIN4_IMAGE_HOST_WEBUI"
    },
    "webui_password": {
      "label": "WebUI 访问密码（默认 123456，建议改掉）",
      "type": "text",
      "default": "123456",
      "env": "AIPLUGIN4_IMAGE_HOST_PASSWORD"
    },
    "cap_mb": {
      "label": "图库容量上限（MB，原图+缩略图；超出按 LRU 淘汰，先清回收站）",
      "type": "number",
      "default": 2048,
      "env": "AIPLUGIN4_IMAGE_HOST_CAP_MB"
    },
    "max_file_mb": {
      "label": "单张图片上限（MB）",
      "type": "number",
      "default": 8,
      "env": "AIPLUGIN4_IMAGE_HOST_MAX_FILE_MB"
    },
    "trash_days": {
      "label": "回收站保留天数（0 = 关闭回收站，删除即彻底删除）",
      "type": "number",
      "default": 7,
      "env": "AIPLUGIN4_IMAGE_HOST_TRASH_DAYS"
    }
  }
}
