{
  "name": "image-host",
  "description": "私人图床 + 图库：按 URL 抓取落库（sha256 哈希去重）、只读分发与 base64 出口、来源/标签/重命名、WebUI 画廊（鉴权）、MCP 工具（搜索/重命名/打标签）",
  "type": "python",
  "entry": "imagehost.py",
  "deps": "requirements.txt",
  "port": 46680,
  "version": "1.0.1",
  "config": {
    "data_dir": {
      "label": "数据目录（SQLite + 原图分片 + 缩略图）",
      "type": "text",
      "default": "{REPO_ROOT}/data/image-host",
      "env": "AIPLUGIN4_IMAGE_HOST_DIR",
      "create_dir": true
    },
    "webui_password": {
      "label": "WebUI 访问密码（留空 = 关闭 WebUI，仅保留 API）",
      "type": "text",
      "default": "",
      "env": "AIPLUGIN4_IMAGE_HOST_PASSWORD"
    },
    "public_base_url": {
      "label": "对外地址前缀（如 https://img.example.com；留空 = 模型侧不可达，插件改用 base64 出口）",
      "type": "text",
      "default": "",
      "env": "AIPLUGIN4_IMAGE_HOST_PUBLIC_BASE_URL"
    },
    "cap_mb": {
      "label": "图库容量上限（MB，原图+缩略图；超出按 LRU 淘汰，先清回收站）",
      "type": "number",
      "default": 2048,
      "env": "AIPLUGIN4_IMAGE_HOST_CAP_MB"
    },
    "max_file_mb": {
      "label": "单张图片上限（MB）",
      "type": "number",
      "default": 8,
      "env": "AIPLUGIN4_IMAGE_HOST_MAX_FILE_MB"
    },
    "trash_days": {
      "label": "回收站保留天数（0 = 关闭回收站，删除即彻底删除）",
      "type": "number",
      "default": 7,
      "env": "AIPLUGIN4_IMAGE_HOST_TRASH_DAYS"
    },
    "change_keep_days": {
      "label": "变更日志保留天数（插件增量同步用）",
      "type": "number",
      "default": 30,
      "env": "AIPLUGIN4_IMAGE_HOST_CHANGE_KEEP_DAYS"
    },
    "thumb_max": {
      "label": "缩略图最大边（像素）",
      "type": "number",
      "default": 512,
      "env": "AIPLUGIN4_IMAGE_HOST_THUMB_MAX"
    },
    "fetch_concurrency": {
      "label": "外部抓取并发上限",
      "type": "number",
      "default": 4,
      "env": "AIPLUGIN4_IMAGE_HOST_FETCH_CONCURRENCY"
    },
    "fetch_timeout": {
      "label": "抓取超时（连接,读取 秒，如 5,20）",
      "type": "text",
      "default": "5,20",
      "env": "AIPLUGIN4_IMAGE_HOST_FETCH_TIMEOUT"
    },
    "allow_hosts": {
      "label": "抓取域名白名单（逗号分隔；留空 = 只做 IP 级 SSRF 拦截）",
      "type": "text",
      "default": "",
      "env": "AIPLUGIN4_IMAGE_HOST_ALLOW_HOSTS"
    }
  }
}
