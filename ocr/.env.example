# 服务监听地址（默认只监听本机；海豹与后端不在同一台机器时改为 0.0.0.0）
HOST=127.0.0.1
PORT=18699

# 默认识别语言（可多个，用 + 连接）
OCR_DEFAULT_LANG=chi_sim+eng

# 语言包目录与缓存目录（默认在 backend 目录内）
# OCR_LANG_DIR=./lang-data
# OCR_CACHE_DIR=./cache

# 预下载语言包时使用（setup-langs.js）
# OCR_LANGS=eng,chi_sim
# OCR_LANG_MIRROR=https://tessdata.projectnaptha.com/4.0.0

# 调试日志：=1 时输出 tesseract.js 阶段日志
# OCR_DEBUG=0

# JSON 请求体上限（base64 图片用）
# MAX_BODY_MB=12
